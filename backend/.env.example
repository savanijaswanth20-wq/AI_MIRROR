DATABASE_PATH=data/mirror.sqlite3
STORAGE_BACKEND=sqlite
FRONTEND_URL=http://localhost:3000
PUBLIC_ASSET_URL=/api/garment-assets
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Set a cryptographically random administrator token for deployment.
ADMIN_TOKEN=
# Tokenless demo admin is permitted only from loopback; disable for deployments.
ALLOW_DEMO_ADMIN=true
# Optional: apply app/database/001_supabase.sql, then use the server-only key.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
